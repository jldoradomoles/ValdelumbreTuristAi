# Proveedor de LLM: "claude" o "fallback" (default)
LLM_PROVIDER=fallback

# Clave de API de Anthropic (solo necesaria si LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Ruta al archivo de datos (dejar vacío para usar el default; se sobreescribe en Docker)
# DATA_PATH=/app/references/datos/pois.json

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=["http://localhost:4200"]
